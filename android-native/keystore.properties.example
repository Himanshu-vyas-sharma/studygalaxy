# Copy to keystore.properties and fill in. NEVER commit the real file.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/studygalaxy-release.jks \
#     -alias studygalaxy -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/studygalaxy-release.jks
storePassword=CHANGE_ME
keyAlias=studygalaxy
keyPassword=CHANGE_ME
