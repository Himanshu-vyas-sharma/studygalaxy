PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# Local dev — plain SQLite file
DATABASE_URL=file:./data/studygalaxy.sqlite

# Production — hosted Turso (free tier)
#   turso db create studygalaxy
#   turso db show studygalaxy --url
#   turso db tokens create studygalaxy
# DATABASE_URL=libsql://studygalaxy-<org>.turso.io
# DATABASE_AUTH_TOKEN=eyJ...

# Set to your deployed frontend origin in production, e.g. https://studygalaxy.netlify.app
CORS_ORIGIN=*
