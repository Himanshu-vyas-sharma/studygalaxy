{
  "name": "StudyGalaxy: Focus with Friends",
  "short_name": "StudyGalaxy",
  "description": "Focus timer for students. Grow your galaxy. Study with friends. See who's focusing live.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#05020D",
  "theme_color": "#05020D",
  "categories": ["education", "productivity", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/home.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Home — your live galaxy and focus portal" },
    { "src": "/screenshots/timer.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Focus timer with live stars" }
  ],
  "shortcuts": [
    { "name": "Start 25 min focus", "short_name": "Focus 25", "url": "/?quick=25", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "View galaxy", "short_name": "Galaxy", "url": "/?view=galaxy", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
